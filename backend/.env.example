# Knovera RAG Assistant - Environment Configuration Example
# Copy this file to .env and configure your secrets

# OpenAI or OpenAI-Compatible API Provider Settings (e.g. OpenRouter, Azure OpenAI, Local Ollama/vLLM)
OPENAI_API_KEY="your_api_key_here"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# LLM Chat Model Name
CHAT_MODEL="gpt-4o-mini"

# Embedding Model Name (e.g., text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002)
EMBEDDING_MODEL="text-embedding-3-small"
EMBED_MODEL="text-embedding-3-small"

# Vector Database Settings (MongoDB Atlas Vector Store)
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Knovera?retryWrites=true&w=majority"
MONGODB_DB_NAME="Knovera"
VECTOR_DB_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Knovera?retryWrites=true&w=majority"
COLLECTION_NAME="knovera_knowledge_base"

# Backend API Server Configuration
API_HOST="0.0.0.0"
API_PORT="8000"
APP_ENV="development"
TOP_K="4"
MIN_TOP_SCORE="0.72"
USE_LIVE_API="false"
